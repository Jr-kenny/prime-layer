# 0G integration — copy to .env and fill in.
# Without a key the app runs in sandbox mode (deterministic local roots).

# mainnet | testnet
ZERO_G_NETWORK=testnet

# Funded signer key on the target network (server-side only, never expose).
# Pays storage gas, mints Agentic IDs, and sends 0G Pay settlements.
ZERO_G_PRIVATE_KEY=

# Optional overrides (defaults come from the network preset)
ZERO_G_RPC_URL=
ZERO_G_INDEXER_RPC=

# 0G Compute Router — LLM grading (separate from the storage signer above).
# Create a key at https://pc.0g.ai (mainnet) or https://pc.testnet.0g.ai (testnet),
# deposit a little 0G, and paste the sk-... key here. Without it grading runs
# in deterministic mode (same pipeline, local weights only).
ZERO_G_COMPUTE_API_KEY=
# Optional: model override (catalog id, default zai-org/GLM-5-FP8)
ZERO_G_COMPUTE_MODEL=
# Optional: explicit router base URL (default follows ZERO_G_NETWORK)
ZERO_G_COMPUTE_BASE_URL=

# Agentic ID (ERC-7857) — on-chain identity NFTs for grid agents.
# Defaults to 0G's pre-deployed contract on testnet (mint fee is currently 0,
# gas paid by ZERO_G_PRIVATE_KEY). Only set these if you deploy your own or
# want to turn minting off:
# AGENTIC_ID_CONTRACT=
# AGENTIC_ID_DISABLED=true

# 0G Pay settlement — real native-token payouts to contributing agents from
# the ZERO_G_PRIVATE_KEY signer. All optional; sane defaults apply:
# PRIME_PAYOUT_BUDGET_OG=0.5      # max OG paid out per inquiry cycle
# PRIME_MIN_PAYOUT_OG=0.001       # dust guard; smaller shares wait for retry
# PRIME_GAS_RESERVE_OG=0.05       # never spend the signer below this
# ZERO_G_PAY_DISABLED=true        # kill-switch: rows stay pending, no transfers

# Privy (email sign-in for workspaces). Create an app at https://dashboard.privy.io
VITE_PRIVY_APP_ID=
