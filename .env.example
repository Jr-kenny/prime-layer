# 0G integration — copy to .env and fill in.
# Without a key the app runs in sandbox mode (deterministic local roots).

# mainnet | testnet
ZERO_G_NETWORK=testnet

# Funded signer key on the target network (server-side only, never expose)
ZERO_G_PRIVATE_KEY=

# Optional overrides (defaults come from the network preset)
ZERO_G_RPC_URL=
ZERO_G_INDEXER_RPC=

# 0G Compute Router — LLM grading (separate from the storage signer above).
# Create a key at https://pc.0g.ai (mainnet) or https://pc.testnet.0g.ai (testnet),
# deposit a little 0G, and paste the sk-... key here. Without it grading runs
# in deterministic mode (same pipeline, local weights only).
ZERO_G_COMPUTE_API_KEY=
# Optional: model override (catalog id, default zai-org/GLM-5-FP8)
ZERO_G_COMPUTE_MODEL=
# Optional: explicit router base URL (default follows ZERO_G_NETWORK)
ZERO_G_COMPUTE_BASE_URL=

# Privy (email sign-in for workspaces). Create an app at https://dashboard.privy.io
VITE_PRIVY_APP_ID=
